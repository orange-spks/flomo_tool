{
  "manifest_version": 3,
  "name": "Flomo Clipper",
  "version": "0.1.2",
  "description": "一键将网页内容同步到 Flomo",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.flomoapp.com/*",
    "https://flomoapp.com/*"
  ],
  "web_accessible_resources": [{
    "resources": ["sidebar.html", "styles/*", "scripts/*"],
    "matches": ["<all_urls>"]
  }],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_title": "Flomo Clipper",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  }
} 